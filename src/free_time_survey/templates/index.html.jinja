<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="{{ url_for('static', filename='main.css') }}" />
        <link rel="icon"
              type="image/svg+xml"
              href="{{ url_for('static', filename='favicon.svg') }}">
        <link rel="icon"
              href="{{ url_for('static', filename='favicon.ico') }}"
              media="(prefers-color-scheme: light)">
        <link rel="icon"
              href="{{ url_for('static', filename='favicon_dark.ico') }}"
              media="(prefers-color-scheme: dark)">
        <title>Boş vaxt sorğusu</title>
    </head>
    <body>
        <header>
            <h1>Boş vaxt sorğusu</h1>
        </header>
        <main>
            <form method="post" action="{{ url_for("submit") }}">
                <div class="input-group">
                    <label for="age">Yaşınız neçədir?</label>
                    <input id="age"
                           name="age"
                           type="number"
                           min="{{ age_cstrs["min"] }}"
                           max="{{ age_cstrs["max"] }}"
                           placeholder="{{ age_cstrs["min"] }}-{{ age_cstrs["max"] }} yaş arası"
                           required />
                </div>
                <div class="input-group">
                    <label for="grade">
                        Neçənci sinifdə
                        oxuyursunuz?
                    </label>
                    <input id="grade"
                           name="grade"
                           type="number"
                           min="{{ grade_cstrs["min"] }}"
                           max="{{ grade_cstrs["max"] }}"
                           placeholder="{{ grade_cstrs["min"] }}-{{ grade_cstrs["max"] }}-ci sinif arası"
                           required />
                </div>
                <div class="input-group">
                    <label for="free_day">
                        Həftənin hansı günü daha çox
                        boş vaxtınız olur?
                    </label>
                    <select name="free_day" id="free_day" required>
                        {% for day in ('Bazar ertəsi', 'Çərşənbə axşamı', 'Çərşənbə', 'Cümə axşamı', 'Cümə', 'Şənbə', 'Bazar') %}
                            <option value="{{ day }}">{{ day }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="input-group">
                    <label for="activity">Ən sevdiyiniz hobbiniz?</label>
                    <select name="activity_id" id="activity" required>
                        {% for id, activity in activities %}
                            <option value="{{ id }}">{{ activity }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="input-group">
                    <label for="companion">
                        Bu hobbinizi kiminlə daha çox
                        sevirsiniz?
                    </label>
                    <select name="companion_id" id="companion" required>
                        {% for id, companion in companions %}
                            <option value="{{ id }}">{{ companion }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="input-group">
                    <label for="hours_per_day">
                        Gündə bu hobbiyə neçə saat
                        ayırırsınız?
                    </label>
                    <input id="hours_per_day"
                           name="hours_per_day"
                           type="number"
                           min="{{ hpd_cstrs["min"] }}"
                           max="{{ hpd_cstrs["max"] }}"
                           placeholder="{{ hpd_cstrs["min"] }}-{{ hpd_cstrs["max"] }} saat arası"
                           required />
                </div>
                <div class="input-group">
                    <label for="satisfaction">
                        Hobbinizdən nə qədər
                        məmnunsunuz?
                    </label>
                    <input id="satisfaction"
                           name="satisfaction"
                           type="number"
                           min="{{ sat_cstrs["min"] }}"
                           max="{{ sat_cstrs["max"] }}"
                           placeholder="{{ sat_cstrs["min"] }}-{{ sat_cstrs["max"] }} arası"
                           required />
                </div>
                <input type="submit" value="Göndər" />
            </form>
        </main>
    </body>
</html>
